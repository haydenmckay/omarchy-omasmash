#!/bin/bash
# Launch the nested Hyprland test compositor with Omasmash running inside it.
#
# Containment, not convenience. A session lock taken in here is held by the
# nested compositor, so the worst case is a stuck window you can kill from the
# host -- see `omasmash-nested --kill`. Never run the crash and kill -9 tests
# against the real session.

set -euo pipefail

# Resolve symlinks before deriving the project root. omasmash-install links
# these onto PATH, and through that link BASH_SOURCE is ~/.local/bin/omasmash,
# so the naive dirname/.. lands on ~/.local and every path built from it is
# wrong -- which silently broke the launcher entry and the hotkey while the
# same commands kept working when run from the repo.
PROJECT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CONF="${XDG_RUNTIME_DIR:-/tmp}/omasmash-nested.conf"

if [[ "${1:-}" == "--kill" ]]; then
  pkill -f "Hyprland -c $CONF" && echo "nested compositor killed" || echo "no nested compositor running"
  exit 0
fi

# Closing the nested window destroys the compositor's only output but leaves
# the process running with nowhere to draw. Every later launch then looks like
# "it isn't loading" -- the compositor is fine, there is simply no window. So
# always clear a stale one before starting. Use --kill rather than closing the
# window and this never arises.
stale=$(pgrep -x Hyprland | while read -r p; do
  tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q omasmash && echo "$p"
done)
if [[ -n "$stale" ]]; then
  echo "clearing stale nested compositor: $stale"
  # shellcheck disable=SC2086
  kill $stale 2>/dev/null
  sleep 2
fi

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
  echo "error: no WAYLAND_DISPLAY -- run this from inside your Wayland session." >&2
  exit 1
fi

sed "s|__PROJECT__|$PROJECT|g" "$PROJECT/dev/nested.conf" > "$CONF"

echo "Starting nested Hyprland. Inside it:"
echo "  SUPER+T          open a terminal"
echo "  SUPER+SHIFT+E    exit the nested session"
echo "From the host, when you are done:  $0 --kill"
echo "(close the window and the compositor keeps running with no output)"
echo

exec Hyprland -c "$CONF"
