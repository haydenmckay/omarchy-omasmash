#!/bin/bash
# Omasmash control CLI (development / standalone mode).
#
# `unlock` is the escape hatch that does not need a TTY. It works as long as
# the process is alive and its IPC socket is answering -- which covers a
# surface that has stopped painting but not a process that has died. For a
# dead process while locked, see RECOVERY in the README.

set -euo pipefail

PROJECT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$PROJECT/dev-shell.qml"

case "${1:-status}" in
  run)     exec quickshell -p "$CONFIG" ;;
  lock)    quickshell -p "$CONFIG" ipc call omasmash lock ;;
  unlock)  quickshell -p "$CONFIG" ipc call omasmash unlock ;;
  locked)  quickshell -p "$CONFIG" ipc call omasmash isLocked ;;
  status)  quickshell -p "$CONFIG" ipc call omasmash status | (command -v jq >/dev/null && jq . || cat) ;;
  *)
    echo "usage: omasmash {run|lock|unlock|locked|status}" >&2
    exit 1
    ;;
esac
