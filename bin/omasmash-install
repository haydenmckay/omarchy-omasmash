#!/bin/bash
# Put Omasmash in the app menu, and put its CLI on PATH.
#
# Optional. `omarchy plugin add` installs the plugin itself; this only adds a
# desktop entry, an icon, and three symlinks.
#
# It will not overwrite anything it does not own. Every target is checked
# first: a file this installer previously created (recorded in its state file),
# a desktop entry carrying our marker, or a symlink already pointing into an
# Omasmash directory counts as ours. Anything else is left alone and reported,
# and the install stops without changing a thing unless you pass --force.
#
# Nothing here touches Hyprland config -- binding a hotkey stays your decision,
# see docs/hotkey.md.

set -uo pipefail

PROJECT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
APPS="$HOME/.local/share/applications"
ICONS="$HOME/.local/share/icons/hicolor/256x256/apps"
BIN="$HOME/.local/bin"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omasmash"
LEDGER="$STATE/installed-files"

DESKTOP="$APPS/Omasmash.desktop"
ICON="$ICONS/omasmash.png"
LINKS=(omasmash omasmash-toggle omasmash-panic)
MARKER="X-Omasmash-Managed=true"

FORCE=0
UNINSTALL=0
for arg in "$@"; do
  case $arg in
    --force)     FORCE=1 ;;
    --uninstall) UNINSTALL=1 ;;
    -h|--help)
      echo "usage: omasmash-install [--force] [--uninstall]"
      echo "  --force      replace targets even when they are not ours"
      echo "  --uninstall  remove only the files this installer created"
      exit 0 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

in_ledger() { [[ -f $LEDGER ]] && grep -qxF "$1" "$LEDGER"; }

# A target is ours if we recorded creating it, if it is a desktop entry
# carrying our marker, or if it is a symlink already pointing at an Omasmash
# directory. Anything else belongs to the user or another package.
is_ours() {
  local target=$1
  [[ -e $target || -L $target ]] || return 0        # absent: free to create
  in_ledger "$target" && return 0
  if [[ -L $target ]]; then
    local dest; dest=$(readlink -f "$target" 2>/dev/null) || return 1
    [[ $dest == *omasmash* ]] && return 0
  fi
  [[ $target == "$DESKTOP" ]] && grep -qF "$MARKER" "$target" 2>/dev/null && return 0
  return 1
}

record() { mkdir -p "$STATE"; grep -qxF "$1" "$LEDGER" 2>/dev/null || echo "$1" >> "$LEDGER"; }

# ---- uninstall -------------------------------------------------------
if (( UNINSTALL )); then
  if [[ ! -f $LEDGER ]]; then
    echo "Nothing to uninstall: no record of an install at $LEDGER"
    exit 0
  fi
  removed=0
  while IFS= read -r path; do
    [[ -n $path ]] || continue
    if [[ -e $path || -L $path ]]; then
      rm -f -- "$path" && { echo "  removed $path"; removed=$((removed+1)); }
    fi
  done < "$LEDGER"
  rm -f "$LEDGER"
  echo "Removed $removed file(s). The plugin itself is untouched:"
  echo "  omarchy plugin remove io.github.haydenmckay.omasmash"
  exit 0
fi

# ---- check before touching anything ----------------------------------
conflicts=()
is_ours "$DESKTOP" || conflicts+=("$DESKTOP")
is_ours "$ICON"    || conflicts+=("$ICON")
for l in "${LINKS[@]}"; do is_ours "$BIN/$l" || conflicts+=("$BIN/$l"); done

if (( ${#conflicts[@]} > 0 && FORCE == 0 )); then
  echo "Refusing to overwrite files this installer does not own:" >&2
  printf '  %s\n' "${conflicts[@]}" >&2
  echo >&2
  echo "Nothing has been changed. Move or delete them yourself, or re-run" >&2
  echo "with --force to replace them." >&2
  exit 1
fi

# ---- install ---------------------------------------------------------
mkdir -p "$APPS" "$ICONS" "$BIN" "$STATE"

install -m 0644 "$PROJECT/share/icons/omasmash.png" "$ICON" && record "$ICON"
install -m 0644 "$PROJECT/share/applications/Omasmash.desktop" "$DESKTOP" && record "$DESKTOP"
for l in "${LINKS[@]}"; do
  ln -sfn "$PROJECT/bin/$l" "$BIN/$l" && record "$BIN/$l"
done

command -v update-desktop-database >/dev/null 2>&1 && \
  update-desktop-database "$APPS" >/dev/null 2>&1

echo "Installed:"
printf '  %s\n' "$DESKTOP" "$ICON"
printf '  %s\n' "${LINKS[@]/#/$BIN/}"
(( ${#conflicts[@]} > 0 )) && echo "  (--force replaced ${#conflicts[@]} pre-existing file(s))"
echo
echo "Search 'Omasmash' in the app menu."
echo "Undo with: $0 --uninstall"
echo "No hotkey is installed -- see docs/hotkey.md if you want one."
