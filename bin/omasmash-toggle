#!/bin/bash
# Toggle smash mode. This is the command a hotkey should be bound to.
#
# Deliberately a toggle rather than a plain lock: the same chord that starts
# it also gets you out, which matters when the person reaching for the
# keyboard has a child on one arm.
#
# NOTE: no keybinding is installed by this project. Binding a chord that locks
# the session is the user's decision to make in their own config -- see
# docs/hotkey.md. Omarchy's own config is never written to by this repo.

set -uo pipefail

# Resolve symlinks before deriving the project root. omasmash-install links
# these onto PATH, and through that link BASH_SOURCE is ~/.local/bin/omasmash,
# so the naive dirname/.. lands on ~/.local and every path built from it is
# wrong -- which silently broke the launcher entry and the hotkey while the
# same commands kept working when run from the repo.
PROJECT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Installed as an Omarchy plugin, the service runs inside the shell's own
# Quickshell instance and is reached through omarchy-shell. A dev checkout has
# no shell plugin, so it falls back to the standalone CLI, which starts its own
# instance on demand.
if command -v omarchy-shell >/dev/null 2>&1; then
  state=$(omarchy-shell omasmash isLocked 2>/dev/null)
  if [[ $state == "true" ]]; then
    exec omarchy-shell omasmash unlock
  elif [[ $state == "false" ]]; then
    exec omarchy-shell omasmash lock
  fi
fi

if [[ "$("$PROJECT/bin/omasmash" locked 2>/dev/null)" == "true" ]]; then
  exec "$PROJECT/bin/omasmash" unlock
else
  exec "$PROJECT/bin/omasmash" lock
fi
